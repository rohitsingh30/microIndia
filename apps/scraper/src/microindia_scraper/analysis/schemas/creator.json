{
 "type": "object",
 "properties": {
  "brand_summary": {
   "type": "string",
   "description": "One paragraph a brand marketer can read in 20 seconds: who this creator is, what they make, how it lands, what they are good for, and the main caution."
  },
  "content_pillars": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "reels": {
      "type": "integer",
      "description": "How many analysed reels belong to it."
     },
     "evidence_reels": {
      "type": "array",
      "items": {
       "type": "string",
       "description": "Reel shortcode from the input."
      }
     }
    },
    "required": [
     "name",
     "description",
     "reels",
     "evidence_reels"
    ],
    "additionalProperties": false
   }
  },
  "signature_formats": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "format": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "evidence_reels": {
      "type": "array",
      "items": {
       "type": "string",
       "description": "Reel shortcode from the input."
      }
     }
    },
    "required": [
     "format",
     "description",
     "evidence_reels"
    ],
    "additionalProperties": false
   }
  },
  "voice": {
   "type": "object",
   "properties": {
    "description": {
     "type": "string",
     "description": "How they come across, in plain words (e.g. 'warm, chatty Chennai mom who demos products in her own kitchen')."
    },
    "tone": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "languages": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "language": {
        "type": "string"
       },
       "usage": {
        "type": "string",
        "enum": [
         "primary",
         "secondary",
         "occasional",
         "captions_only"
        ]
       },
       "evidence_reels": {
        "type": "array",
        "items": {
         "type": "string",
         "description": "Reel shortcode from the input."
        }
       }
      },
      "required": [
       "language",
       "usage",
       "evidence_reels"
      ],
      "additionalProperties": false
     }
    },
    "face_on_camera": {
     "type": "string",
     "enum": [
      "usually",
      "sometimes",
      "rarely",
      "unknown"
     ]
    }
   },
   "required": [
    "description",
    "tone",
    "languages",
    "face_on_camera"
   ],
   "additionalProperties": false
  },
  "audience_persona": {
   "type": "object",
   "properties": {
    "description": {
     "type": "string",
     "description": "Who the content is made for, from the content itself. No age/gender numbers."
    },
    "evidence_reels": {
     "type": "array",
     "items": {
      "type": "string",
      "description": "Reel shortcode from the input."
     }
    }
   },
   "required": [
    "description",
    "evidence_reels"
   ],
   "additionalProperties": false
  },
  "production_level": {
   "type": "object",
   "properties": {
    "score": {
     "type": "integer",
     "minimum": 1,
     "maximum": 5
    },
    "description": {
     "type": "string"
    },
    "evidence_reels": {
     "type": "array",
     "items": {
      "type": "string",
      "description": "Reel shortcode from the input."
     }
    }
   },
   "required": [
    "score",
    "description",
    "evidence_reels"
   ],
   "additionalProperties": false
  },
  "brands": {
   "type": "object",
   "properties": {
    "worked_with": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "brand": {
        "type": "string"
       },
       "relationship": {
        "type": "string",
        "enum": [
         "paid_partnership",
         "disclosed_ad",
         "gifted_or_pr",
         "collab_post",
         "likely_undisclosed_promo",
         "organic_mention"
        ]
       },
       "evidence_reels": {
        "type": "array",
        "items": {
         "type": "string",
         "description": "Reel shortcode from the input."
        }
       }
      },
      "required": [
       "brand",
       "relationship",
       "evidence_reels"
      ],
      "additionalProperties": false
     }
    },
    "sponsored_vs_organic": {
     "type": "string",
     "description": "How sponsored reels performed against organic ones, using only the numbers given. Say so when the sample is too small."
    },
    "brand_readiness": {
     "type": "string",
     "description": "How ready they are for brand work: disclosure habits, integration style, consistency."
    }
   },
   "required": [
    "worked_with",
    "sponsored_vs_organic",
    "brand_readiness"
   ],
   "additionalProperties": false
  },
