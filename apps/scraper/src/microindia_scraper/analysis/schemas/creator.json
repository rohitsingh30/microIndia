   "items": {
    "type": "object",
    "properties": {
     "niche": {
      "type": "string",
      "enum": [
       "food",
       "baking",
       "fashion",
       "ethnic wear",
       "beauty",
       "skincare",
       "fitness",
       "yoga & wellness",
       "nutrition & health",
       "travel",
       "trekking & outdoors",
       "tech",
       "coding & careers",
       "finance",
       "business & startups",
       "education",
       "parenting",
       "comedy",
       "dance",
       "music",
       "art & design",
       "photography",
       "film & acting",
       "gaming",
       "auto",
       "pets",
       "books",
       "home & decor",
       "diy & crafts",
       "weddings",
       "spirituality",
       "sports",
       "sustainability",
       "farming & rural",
       "law & public affairs",
       "lifestyle & vlogs"
      ]
     },
     "fit": {
      "type": "string",
      "enum": [
       "strong",
       "moderate",
       "weak"
      ]
     },
     "why": {
      "type": "string"
     },
     "evidence_reels": {
      "type": "array",
      "items": {
       "type": "string",
       "description": "Reel shortcode from the input."
      }
     }
    },
    "required": [
     "niche",
     "fit",
     "why",
     "evidence_reels"
    ],
    "additionalProperties": false
   }
  },
  "brand_safety": {
   "type": "object",
   "properties": {
    "rating": {
     "type": "string",
     "enum": [
      "safe",
      "caution",
      "risky",
      "unknown"
     ]
    },
    "summary": {
     "type": "string"
    },
    "flags": {
     "type": "array",
     "items": {
      "type": "object",
      "properties": {
       "flag": {
        "type": "string"
       },
       "evidence_reels": {
        "type": "array",
        "items": {
         "type": "string",
         "description": "Reel shortcode from the input."
        }
       }
      },
      "required": [
       "flag",
       "evidence_reels"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "rating",
    "summary",
    "flags"
   ],
   "additionalProperties": false
  },
  "strengths": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "point": {
      "type": "string"
     },
     "evidence_reels": {
      "type": "array",
      "items": {
       "type": "string",
       "description": "Reel shortcode from the input."
      }
     }
    },
    "required": [
     "point",
     "evidence_reels"
    ],
    "additionalProperties": false
   }
  },
  "risks": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "point": {
      "type": "string"
     },
     "evidence_reels": {
      "type": "array",
      "items": {
       "type": "string",
       "description": "Reel shortcode from the input."
      }
     }
    },
    "required": [
     "point",
     "evidence_reels"
    ],
    "additionalProperties": false
   }
  },
  "pitch_angles": {
   "type": "array",
   "minItems": 3,
   "maxItems": 3,
   "items": {
    "type": "object",
    "properties": {
     "angle": {
      "type": "string"
     },
     "idea": {
      "type": "string",
      "description": "A concrete reel idea a brand could brief, in this creator's style."
     },
     "suits": {
      "type": "string",
      "description": "Kind of brand/product it suits."
     },
     "evidence_reels": {
      "type": "array",
      "items": {
       "type": "string",
       "description": "Reel shortcode from the input."
      }
     }
    },
    "required": [
     "angle",
     "idea",
     "suits",
     "evidence_reels"
    ],
    "additionalProperties": false
   }
  },
  "unknowns": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
